rules_version = '2';
// Roster Review security rules.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
// Keep these two lists in sync with src/config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && email() in [
        'janie.houlgrave@compass.com',
        'ariel.mantilla@compass.com',
        'sarah.tareen@compass.com'
      ];
    }
    function isStaff() {
      return signedIn() && email() in [
        'alex.asmar@compass.com',
        'alexis.coballes@compass.com',
        'ariel.mantilla@compass.com',
        'janie.houlgrave@compass.com',
        'jessica.tan@compass.com',
        'kathleen.walsh@compass.com',
        'lindsey.mcnerney@compass.com',
        'natalie.robinson@compass.com',
        'skylar.herrle@compass.com',
        'toria.hester@compass.com',
        'sarah.tareen@compass.com'
      ];
    }

    // The roster: everyone on the list can read it, only admins can replace it.
    match /roster/{doc} {
      allow read: if isStaff() || isAdmin();
      allow write: if isAdmin();
    }

    // Reviews: one document per person per team, named <their user id>__<team>.
    // Staff read and write only their own. Admins read everyone's and can't edit anyone else's.
    match /responses/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create, update: if isStaff()
        && id.split('__')[0] == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email();
      allow delete: if false;
    }

    // The shared re-org draft: admins only.
    match /reorg/{doc} {
      allow read, write: if isAdmin();
    }

    match /{everythingElse=**} { allow read, write: if false; }
  }
}
